.vercel/
next.user-config.*

# Environment variables
.env
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
.vercel

# Backend build artifacts
backend/tmp/
backend/bin/
*.exe

# Uploaded files
data/uploads/

# Database backups
backups/


# Runtime artifacts
/logs/
.rollback/
backend/main
tsconfig.tsbuildinfo
*.log

# Offline deployment assets (large binaries, managed manually)
offline/*.tar.gz
offline/*.tar.xz
offline/*.sh
offline/pnpm
offline/pnpm-*.tgz
offline/docker-images/*.tar
offline/debs/*.deb

# Release packages (USB delivery, built by scripts/package-release.sh)
/release/

# Image editor assets: 仓库中是指向 offline/image-editor 的符号链接，
# deploy.sh 构建时会替换为实体文件；禁止把实体文件提交入库
/apps/edu/public/image-editor/

# file-viewer CAD WASM assets: 由 prebuild 脚本从 node_modules 复制生成，不提交入库
/apps/edu/public/wasm/
