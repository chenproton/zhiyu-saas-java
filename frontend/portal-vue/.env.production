# 生产环境
VITE_APP_ENV = 'production'
# 应用访问路径前缀（与 Java 前端一致：/java/portal，java-nginx 直接服务、不剥离 /java/）
VITE_APP_BASE_PATH = '/java/portal/'
# 后端 API 基础路径：走 80 统一入口（边缘 nginx location /java/ → java-nginx → java-backend /api/）。
# 不能用 '/api/v1'：同域下 /api/v1 会被边缘 nginx 路由到 Go 后端（8084），Java 门户请求全部打错栈。
# 直连 8083 调试时 java-site.conf 仍保留 location /api/，两种访问方式都可用。
VITE_API_BASE = '/java/api/v1'
