# ==========================
# 数据库与认证（必填）
# ==========================
# 默认指向 deploy/docker-compose.yml 中映射到本机的 Postgres 端口 5433。
# 若使用外部数据库，请改为实际地址。
DATABASE_URL=postgresql://zhiyu_saas:change-me@127.0.0.1:5433/zhiyu-saas?sslmode=disable
JWT_SECRET=change-me-in-production

# 数据库连接变量（docker compose 直接读取；deploy.sh 会自动从 DATABASE_URL 提取）
DB_USER=zhiyu_saas
DB_PASSWORD=change-me
DB_NAME=zhiyu-saas

# ==========================
# 服务端口
# ==========================
PORT=8080
# EDU_PORT=3020                # Next.js edu 应用监听端口

# ==========================
# 部署与运维（deploy.sh 使用）
# ==========================
# 代码仓库地址（空白服务器首次部署时用于 git clone）
# REPO_URL=https://github.com/your-org/zhiyu-saas.git

# Nginx / OpenResty 容器名或 nginx 二进制路径（用于部署后 reload）
# NGINX_CONTAINER=openresty

# ==========================
# 种子数据
# ==========================
# 首次初始化数据库时 platform_admin（admin）的密码；未设置时自动生成随机密码并打印一次
# SEED_ADMIN_PASSWORD=change-me

# ==========================
# 前端外部平台链接（apps/edu 使用，均有默认值，按需覆盖）
# ==========================
# NEXT_PUBLIC_CAREER_PLATFORM_URL=http://111.170.170.202:3002
# NEXT_PUBLIC_SCENE_PLATFORM_URL=http://111.170.170.202:3003   # 含评分 iframe，建议 https
# NEXT_PUBLIC_ALLIANCE_PLATFORM_URL=http://111.170.170.202:3004
# NEXT_PUBLIC_ABILITY_PLATFORM_URL=http://111.170.170.202:3005
# NEXT_PUBLIC_COURSE_LEARN_URL=http://111.170.170.202:3006
# NEXT_PUBLIC_MALL_URL=http://111.170.170.202:3010
# NEXT_PUBLIC_AI_ASSISTANT_URL=http://demo2.zhiyu.com.cn:5000

# ==========================
# 测试
# ==========================
# 后端集成测试数据库；未设置时部分测试会跳过
# TEST_DATABASE_URL=postgresql://zhiyu_saas:change-me@127.0.0.1:5432/zhiyu-saas-test?sslmode=require
