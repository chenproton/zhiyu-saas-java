# ==========================
# 数据库与认证（必填）
# ==========================
# 默认指向 deploy/docker-compose.yml 中映射到本机的 Postgres 端口 5433。
# 若使用外部数据库，请改为实际地址。
DATABASE_URL=postgresql://zhiyu_saas:zhiyu%404024@127.0.0.1:5433/zhiyu-saas?sslmode=disable
JWT_SECRET=change-me-in-production

# 数据库连接变量（docker compose 直接读取；deploy.sh 会自动从 DATABASE_URL 提取）
DB_USER=zhiyu_saas
DB_PASSWORD=zhiyu@4024
DB_NAME=zhiyu-saas

# ==========================
# 服务端口
# ==========================
PORT=8080
# BACKEND_PORT_ENV=8080        # deploy.sh 读取，用于后端服务端口
# EDU_PORT=3020                # Next.js edu 应用监听端口

# ==========================
# 部署与运维（deploy.sh 使用）
# ==========================
# 代码仓库地址（空白服务器首次部署时用于 git clone）
# REPO_URL=https://github.com/your-org/zhiyu-saas.git

# 部署目标目录（deploy.sh 会将运行时产物部署到该目录，与代码仓库分离）
# DEPLOY_DIR=/opt/zhiyu-saas

# 文件上传保存目录（默认在部署目录下；开发环境可留空，使用项目内 ../public/uploads）
# UPLOAD_DIR=/opt/zhiyu-saas/data/uploads

# 回滚快照保留数量
# ROLLBACK_KEEP=5

# 前端构建 CPU 限制（百分比，例如 200 表示使用 2 核）
# BUILD_CPU_QUOTA=0

# Nginx / OpenResty 容器名或 nginx 二进制路径（用于部署后 reload）
# NGINX_CONTAINER=openresty

# ==========================
# 调试与安全（仅开发环境）
# ==========================
# 开启模拟登录 token 接口（生产环境务必保持关闭）
# ENABLE_DEBUG_AUTH=true
# DEBUG_AUTH_TOKEN=debug-token-change-me

# ==========================
# 测试
# ==========================
# 后端集成测试数据库；未设置时部分测试会跳过
# TEST_DATABASE_URL=postgresql://zhiyu_saas:zhiyu%404024@127.0.0.1:5432/zhiyu-saas-test?sslmode=require
