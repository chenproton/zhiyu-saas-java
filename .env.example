# ==========================
# 数据库与认证（必填）
# ==========================
# 默认指向 deploy/docker-compose.yml 中映射到本机的 Postgres 端口 5433。
# 若使用外部数据库，请改为实际地址。
DATABASE_URL=postgresql://zhiyu_saas:change-me@127.0.0.1:5433/zhiyu-saas?sslmode=disable
JWT_SECRET=change-me-in-production
# 用于加密租户 AI API Key（AES-256-GCM 密钥派生）；缺省时回落 JWT_SECRET
AI_CONFIG_SECRET=

# 数据库连接变量（docker compose 直接读取；deploy.sh 会自动从 DATABASE_URL 提取）
DB_USER=zhiyu_saas
DB_PASSWORD=change-me
DB_NAME=zhiyu-saas

# ==========================
# 服务端口
# ==========================
PORT=8080
# EDU_PORT=3020                # Next.js edu 应用监听端口

# ==========================
# 部署与运维（deploy.sh 使用）
# ==========================
# 代码仓库地址（空白服务器首次部署时用于 git clone）
# REPO_URL=https://github.com/your-org/zhiyu-saas.git

# Go 版本（空白服务器首次安装时使用，可配置以适配国内镜像）
# GO_VERSION=1.23.7

# Node.js 版本（空白服务器首次安装时使用，需与 offline/ 中安装包对应）
# NODE_VERSION=22.12.0

# 离线资源目录（默认与 deploy.sh 同级的 offline/，留空即使用默认）
# OFFLINE_DIR=/path/to/offline

# Docker 镜像标签（deploy.sh 自动写入，一般无需手动修改）
# IMAGE_TAG=latest

# Docker Hub 镜像加速地址，逗号分隔多个 URL；留空则使用 docker hub 直连
# 示例：DOCKER_REGISTRY_MIRRORS=https://docker.1panel.live,https://docker.m.daocloud.io
# DOCKER_REGISTRY_MIRRORS=

# nginx 入口配置（空白服务器首次部署时生成）
# NGINX_SERVER_NAME=_              # 多个域名用空格分隔，_ 表示捕获所有请求
# NGINX_DEFAULT_SERVER=default_server  # 设为空则不使用 default_server，避免与现有站点冲突
# NGINX_PORT=80                    # 80 被占用时 deploy.sh 会自动回退到 2026
# NGINX_SSL_DOMAIN=your-domain     # HTTPS 域名，设置后 deploy.sh 自动生成 SSL server 块
# NGINX_SSL_CERT=/etc/letsencrypt/live/your-domain/fullchain.pem   # SSL 证书路径
# NGINX_SSL_CERT_KEY=/etc/letsencrypt/live/your-domain/privkey.pem # SSL 密钥路径

# 服务端口（空白服务器首次部署时生成；若被占用会自动使用备用端口）
# BACKEND_PORT=8080                # 后端 API 主机端口，备用 8081
# EDU_PORT=3020                    # edu 前端主机端口，备用 3021
# POSTGRES_HOST_PORT=5433          # Postgres 主机映射端口，备用 5434
# KKFILEVIEW_HOST_PORT=8012        # kkFileView 主机映射端口，备用 8013

# kkFileView 文件预览服务（默认启用）
# ENABLE_KKFILEVIEW=true           # 设置为 false 时 deploy.sh 不会拉起 kkfileview 服务
# KKFILEVIEW_IMAGE=fangzhengjin/kkfileview:4.4.0  # 可替换为国内镜像
# KK_BASE_URL=https://ai.zhiyu.com.cn/kkfileview  # 对外访问 kkfileview 的完整 URL，必须和 nginx 代理协议保持一致；首次部署时 deploy.sh 会根据 nginx 配置自动推导，手动配置可覆盖

# ==========================
# 种子数据
# ==========================
# 首次初始化数据库时平台管理员（admin）的密码；留空则自动生成随机密码
SEED_ADMIN_PASSWORD=admin123

# ==========================
# 前端外部平台链接（apps/edu 使用，均有默认值，按需覆盖）
# 注意：正式 https 部署时，以下平台地址若未显式配置会回退到 http 演示地址，
# 浏览器将因混合内容拦截导致跨平台跳转/评分 iframe 静默失效，请务必填 https 地址。
# ==========================
# NEXT_PUBLIC_SITE_URL=https://ai.zhiyu.com.cn   # 手机可访问的站点地址，用于"移动端访问"二维码；必须与 nginx 代理协议保持一致
# NEXT_PUBLIC_CAREER_PLATFORM_URL=https://example.com   # 生产 https 部署必填（否则回退 http 演示地址）
# NEXT_PUBLIC_SCENE_PLATFORM_URL=https://example.com   # 含评分 iframe，生产 https 部署必填 https 地址
# NEXT_PUBLIC_ALLIANCE_PLATFORM_URL=https://example.com
# NEXT_PUBLIC_ABILITY_PLATFORM_URL=https://example.com
# NEXT_PUBLIC_COURSE_LEARN_URL=https://example.com
# NEXT_PUBLIC_MALL_URL=https://example.com
# NEXT_PUBLIC_AI_ASSISTANT_URL=https://example.com

# ==========================
# 测试
# ==========================
# 后端集成测试数据库；未设置时部分测试会跳过
# TEST_DATABASE_URL=postgresql://zhiyu_saas:change-me@127.0.0.1:5432/zhiyu-saas-test?sslmode=require
