{
  "name": "zhiyu-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:portal": "pnpm -C plus-ui dev:portal",
    "build:portal": "pnpm -C plus-ui build:portal",
    "build:plus-ui": "pnpm -C plus-ui build:admin",
    "build:all": "pnpm -C plus-ui build",
    "lint": "pnpm -C plus-ui lint",
    "format": "prettier --write \"plus-ui/src-portal/**/*.{ts,vue,js,mjs,cjs,css,json}\"",
    "format:check": "prettier --check \"plus-ui/src-portal/**/*.{ts,vue,js,mjs,cjs,css,json}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
