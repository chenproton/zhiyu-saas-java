{
  "name": "zhiyu-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:portal": "pnpm --filter portal-vue dev",
    "build:portal": "pnpm --filter portal-vue build",
    "build:plus-ui": "pnpm --filter plus-ui build",
    "build:all": "pnpm build:portal && pnpm build:plus-ui",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"frontend/portal-vue/**/*.{ts,vue,js,mjs,cjs,css,json}\"",
    "format:check": "prettier --check \"frontend/portal-vue/**/*.{ts,vue,js,mjs,cjs,css,json}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
