{
  "name": "zhiyu-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:edu": "pnpm --filter @zhiyu/edu dev",
    "build:edu": "pnpm --filter @zhiyu/edu build",
    "build:backend": "cd backend && go build -o bin/server ./cmd/server/main.go",
    "build:all": "pnpm build:backend && pnpm build:edu",
    "lint": "pnpm --filter @zhiyu/edu lint",
    "test": "pnpm --filter @zhiyu/edu test && pnpm --filter @zhiyu/api-client test",
    "typecheck": "pnpm -r typecheck"
  }
}
